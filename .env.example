# Copy to .env and fill in locally. Never commit .env.
# .env is git-ignored by this repo — see .gitignore.

# Personal Anthropic API key, used only by scripts/compile_memory.py.
# This is separate from any Claude subscription — API usage bills separately.
# Get one at https://console.anthropic.com/ (use a personal account, not an employer's).
ANTHROPIC_API_KEY=

# Model used for memory compilation. Configurable — no employer key or model is hardcoded here.
COMPILE_MODEL=claude-sonnet-5
